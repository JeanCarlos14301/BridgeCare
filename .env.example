# BridgeCare configuration template. Copy to .env (never commit .env).
# Share real secrets only through a private channel, never in the team chat or Git.

# --- Runtime ---
APP_ENV=development
DEMO_MODE=true
# Uploads stay off: only synthetic fixtures may reach the model (Token Factory terms).
ALLOW_UPLOADS=false

# --- Model provider ---
# mock = offline replay of fixtures (UI shows MOCK). Switch to AMD Token Factory with:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://developer.amd.com.cn/radeon/api
#   LLM_API_KEY=<team key rc-...>
#   LLM_MODEL=MiMo-V2.6-Flash
#   LLM_REASONING_EFFORT=none
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=
LLM_MAX_OUTPUT_TOKENS=4096

# --- Storage (Docker uses /data on the api-data volume; native runs ignore this file) ---
DATABASE_URL=sqlite:////data/app.db
CORS_ORIGINS=http://localhost:5173

# --- Reviewer access and sessions ---
# REVIEWER_PASSWORD: 12+ characters; empty disables reviewer login.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(18))"
# SESSION_SECRET: 32+ characters; required outside development and for public URLs.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
REVIEWER_PASSWORD=
SESSION_SECRET=

# --- Evolus (disabled stub) ---
EVOLUS_ENABLED=false
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# --- Public deployment with Caddy only (compose.prod.yaml); see docs/deploy.md ---
PUBLIC_HOST=
